# Azure RAG System Environment Variables Template
# Copy this file to .env and fill in your actual values

# Pinecone Vector Database
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=your_pinecone_index_name_here

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string_here
AZURE_STORAGE_CONTAINER_NAME=your_container_name_here

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Azure Container Registry (if using ACR)
ACR_LOGIN_SERVER=your_acr_name.azurecr.io
ACR_USERNAME=your_acr_username
ACR_PASSWORD=your_acr_password

# Azure Container Apps Configuration
AZURE_RESOURCE_GROUP=rag-system-rg
AZURE_LOCATION=westeurope
AZURE_CONTAINER_APP_NAME=rag-system-app
AZURE_ENVIRONMENT_NAME=rag-system-env

# Scaling Configuration
MIN_REPLICAS=1
MAX_REPLICAS=10
CPU_REQUEST=2.0
MEMORY_REQUEST=4.0Gi

# Monitoring Configuration
APPLICATION_INSIGHTS_CONNECTION_STRING=your_app_insights_connection_string_here
LOG_ANALYTICS_WORKSPACE_ID=your_log_analytics_workspace_id_here

# Security Configuration
ENABLE_HTTPS=true
ENABLE_AUTHENTICATION=false
CORS_ORIGINS=*

# Performance Configuration
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=200
STREAMLIT_SERVER_MAX_MESSAGE_SIZE=200
STREAMLIT_SERVER_ENABLE_CORS=true
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true

# RAG System Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
TEMPERATURE=0.0
MAX_TOKENS=4000

# Cache Configuration
ENABLE_CACHING=true
CACHE_TTL=3600
VECTOR_CACHE_SIZE=1000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_STRUCTURED_LOGGING=true
